# ============================================
# EMPODÉRATE - Variables de Entorno
# ============================================
# Copiar este archivo a .env y completar con valores reales
# NUNCA commitear el archivo .env al repositorio

# ============================================
# Firebase Configuration
# ============================================
# Obtener de: Firebase Console > Project Settings

# Development
FIREBASE_API_KEY_DEV=AIzaSy...
FIREBASE_APP_ID_DEV=1:123456789:web:abc123

# Staging
FIREBASE_API_KEY_STAGING=AIzaSy...
FIREBASE_APP_ID_STAGING=1:123456789:web:def456

# Production
FIREBASE_API_KEY_PROD=AIzaSy...
FIREBASE_APP_ID_PROD=1:987654321:web:ghi789

# ============================================
# Cloud Functions URLs
# ============================================
FUNCTIONS_URL_DEV=http://localhost:5001/empoderate-dev/us-central1
FUNCTIONS_URL_STAGING=https://us-central1-empoderate-staging.cloudfunctions.net
FUNCTIONS_URL_PROD=https://us-central1-empoderate-prod.cloudfunctions.net

# ============================================
# OpenAI Configuration
# ============================================
# Obtener de: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_ORG_ID=org-...
OPENAI_MODEL=gpt-4o-mini

# ============================================
# 2Checkout (Verifone) - PROVEEDOR PRINCIPAL
# ============================================
# Obtener de: 2Checkout Dashboard
TWOCHECKOUT_SELLER_ID=123456
TWOCHECKOUT_SECRET_KEY=your-secret-key
TWOCHECKOUT_PUBLISHABLE_KEY=your-publishable-key
TWOCHECKOUT_MODE=sandbox  # sandbox o live

# ============================================
# PayPal - PROVEEDOR ALTERNATIVO
# ============================================
# Obtener de: PayPal Developer Dashboard
PAYPAL_CLIENT_ID=AYourClientId...
PAYPAL_SECRET=EYourSecret...
PAYPAL_MODE=sandbox  # sandbox o live

# ============================================
# Sentry (Error Tracking)
# ============================================
# Obtener de: Sentry.io > Settings > Client Keys (DSN)
SENTRY_DSN=https://xyz@abc.ingest.sentry.io/123456
SENTRY_ENVIRONMENT=production  # development, staging, o production

# ============================================
# App URLs
# ============================================
APP_URL_DEV=http://localhost:8080
APP_URL_STAGING=https://staging.empoderate.com
APP_URL_PROD=https://app.empoderate.com

BLOG_URL=https://empoderate.com/blog

# ============================================
# Security
# ============================================
# Clave secreta para firmar tokens (generar con: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# CORS Origins permitidos (separados por comas)
CORS_ORIGINS=http://localhost:8080,https://app.empoderate.com

# ============================================
# Rate Limiting
# ============================================
AI_RATE_LIMIT_FREE=5         # requests por día
AI_RATE_LIMIT_CRECIMIENTO=50
AI_RATE_LIMIT_PRO=200
AI_RATE_LIMIT_EMPRESARIAL=1000

# ============================================
# Logging
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
ENABLE_FUNCTION_LOGS=true
