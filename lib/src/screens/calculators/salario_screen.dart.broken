              ),
              
              const SizedBox(height: 32),
              if (_result != null) _buildResultSection(),
              
              // HISTORY SECTION
              if (_selectedWorkerId != null && _workers.any((w) => w.id == _selectedWorkerId) && _workers.firstWhere((w) => w.id == _selectedWorkerId).payrollHistory.isNotEmpty)
                 _buildHistorySection(),

              const SizedBox(height: 32),
              // Navigation Buttons requested by user
              Column(
                children: [
                   Row(
                     children: [
                       Expanded(
                         child: NeonButton(
                           text: 'Ir a Liquidación',
                           icon: Icons.exit_to_app,
