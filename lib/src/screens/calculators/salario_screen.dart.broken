                    NeonInput(label: 'Horas Extra Diurnas (6am-6pm)', hint: '+25%', isNumber: true, onChanged: (v) => _input.horasExtraDiurna = double.tryParse(v) ?? 0),
                    const SizedBox(height: 10),
                    NeonInput(label: 'Horas Extra Nocturnas (6pm-6am)', hint: '+50%', isNumber: true, onChanged: (v) => _input.horasExtraNocturna = double.tryParse(v) ?? 0),
                    const SizedBox(height: 10),
                    NeonInput(label: 'Prolongación Nocturna', hint: '+75%', isNumber: true, onChanged: (v) => _input.horasExtraMixtaNocturna = double.tryParse(v) ?? 0),
