                                  context, 
                                  icon: Icons.home_outlined, 
                                  title: 'Inicio', 
                                  route: AppRoutes.root,
                                  color: kNeonBlue
                                ),
                                VisibilityBuilder(
                                  id: 'home.ruta_exito',
                                  child: _buildMenuItem(
                                    context, 
                                    icon: Icons.flag_outlined,
                                    title: 'La Ruta al Éxito', 
                                    route: AppRoutes.laRutaAlExito,
                                    color: kNeonPurple
                                  ),
                                ),
                                VisibilityBuilder(
                                  id: 'home.my_business',
