                          _buildSectionLabel('HERRAMIENTAS'),
                          VisibilityBuilder(
                            id: 'tools.general',
                            child: _buildMenuItem(
                              context, 
                              icon: Icons.grid_view, 
                              title: 'Herramientas', 
                              route: AppRoutes.tools,
                              color: kNeonCyan
                            ),
                          ),
                          VisibilityBuilder(
                            id: 'tools.calculators',
                            child: _buildMenuItem(
                              context, 
                              icon: Icons.calculate_outlined,
                              title: 'Calculadoras', 
                              route: AppRoutes.calculadoras,
                              color: kNeonGreen
                            ),
                          ),
                          VisibilityBuilder(
