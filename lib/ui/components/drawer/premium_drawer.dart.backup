                          ),
                          
                          const SizedBox(height: 16),
                          
                          // SECTION 3: RECURSOS HUMANOS
                          _buildSectionLabel('RECURSOS HUMANOS'),
                          VisibilityBuilder(
                            id: 'home.hr',
